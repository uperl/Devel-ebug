#!/usr/bin/env perl

use strict;
use warnings;
use lib::findbin '../lib'; # dev-only

# PODNAME: ebug_backend_perl
# ABSTRACT: Backend for ebug
# VERSION

=head1 SEE ALSO

L<Devel::ebug>

=cut

# On Windows exec starts a new process and exits this one, so the frontend
# would see the process it started die before the backend connects.  Wait
# for the backend instead, and exit with its status.
if ($^O eq 'MSWin32') {
  system $^X, "-d:ebug::Backend", @ARGV;
  exit($? == -1 ? 255 : $? >> 8);
}

exec $^X, "-d:ebug::Backend", @ARGV;

